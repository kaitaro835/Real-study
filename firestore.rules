rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // USER RULES
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid is string &&
               data.displayName is string && data.displayName.size() <= 50 &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
               (data.bio == null || (data.bio is string && data.bio.size() <= 200)) &&
               data.streak is int &&
               data.totalMinutes is int &&
               data.followersCount is int &&
               data.followingCount is int &&
               data.createdAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().uid == request.auth.uid &&
                      incoming().streak == 0 &&
                      incoming().totalMinutes == 0 &&
                      incoming().followersCount == 0 &&
                      incoming().followingCount == 0 &&
                      incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && (
                      // Profile owner updates
                      (isOwner(userId) && 
                        isValidUser(incoming()) &&
                        incoming().uid == existing().uid &&
                        incoming().createdAt == existing().createdAt &&
                        (
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio']) ||
                          incoming().diff(existing()).affectedKeys().hasAny(['streak', 'totalMinutes', 'followingCount'])
                        )
                      ) ||
                      // Anyone can update followersCount (for follow/unfollow)
                      (
                        isValidUser(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['followersCount']) &&
                        (incoming().followersCount == existing().followersCount + 1 || incoming().followersCount == existing().followersCount - 1)
                      )
                    );
    }

    // FOLLOW RULES
    match /follows/{followId} {
      function isValidFollow(data) {
        return data.followerId == request.auth.uid &&
               data.followingId is string &&
               data.createdAt == request.time;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFollow(incoming());
      // Support setDoc as update if it's the exact same data
      allow update: if isSignedIn() && isValidFollow(incoming()) && incoming().followerId == existing().followerId;
      allow delete: if isSignedIn() && existing().followerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && (
          (resource != null && request.auth.uid in resource.data.participants) ||
          (request.resource != null && request.auth.uid in request.resource.data.participants)
        );
      }

      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size() == 2;
      allow update: if isParticipant();

      match /messages/{messageId} {
        function canInteractMessages() {
          return isSignedIn() && exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
                 request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if canInteractMessages();
        allow create: if canInteractMessages() && request.resource.data.userId == request.auth.uid;
      }
    }

    // STACK RULES
    match /stacks/{stackId} {
      function isValidStack(data) {
        return data.userId is string &&
               data.userName is string &&
               (data.userPhotoURL == null || data.userPhotoURL is string) &&
               data.activity is string && data.activity.size() <= 50 &&
               data.durationMinutes is int &&
               data.startTime is timestamp &&
               data.endTime is timestamp &&
               (data.photoURL == null || data.photoURL is string) &&
               (data.note == null || (data.note is string && data.note.size() <= 500)) &&
               data.likesCount is int &&
               data.commentsCount is int &&
               data.createdAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                      isValidStack(incoming()) && 
                      incoming().userId == request.auth.uid &&
                      incoming().likesCount == 0 &&
                      incoming().commentsCount == 0 &&
                      incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && 
                      isValidStack(incoming()) &&
                      (
                        // Liking
                        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
                      );
      
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // CHANNEL RULES
    match /channels/{channelId} {
      allow read: if isSignedIn();
      // Only system or admin creates channels (simplified for now)
      allow write: if false;
      
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.channelId == channelId &&
                 data.userId == request.auth.uid &&
                 data.content is string && data.content.size() <= 1000 &&
                 data.createdAt is timestamp;
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidMessage(incoming()) && incoming().createdAt == request.time;
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }
    }
  }
}
